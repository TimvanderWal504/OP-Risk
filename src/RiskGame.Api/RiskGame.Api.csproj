<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\RiskGame.Rules\RiskGame.Rules.csproj" />
    <ProjectReference Include="..\RiskGame.Persistence\RiskGame.Persistence.csproj" />
  </ItemGroup>

  <!--
    Zelfde aanpak als RiskGame.Persistence.Tests: draait tegen de echte speeldata,
    niet tegen een kopie.
  -->
  <ItemGroup>
    <Content Include="..\..\data\maps\standaard-43\*.json" Link="data\maps\standaard-43\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- Kaartachtergrond voor de TV-kaartlaag (TO §7.2); geserveerd via GameEndpoints,
         niet via generieke static-file-hosting (zie de doc-comment daar). -->
    <Content Include="..\..\data\maps\standaard-43\*.png" Link="data\maps\standaard-43\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- colors.json en starting-armies-presets.json zijn gedeeld over kaartvarianten en
         staan in data/, niet data/maps/{mapId}/. -->
    <Content Include="..\..\data\colors.json" Link="data\colors.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\data\starting-armies-presets.json" Link="data\starting-armies-presets.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
