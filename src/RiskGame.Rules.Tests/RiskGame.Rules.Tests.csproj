<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RiskGame.Rules\RiskGame.Rules.csproj" />
  </ItemGroup>

  <!--
    De tests draaien tegen de echte speeldata, niet tegen kopieën: zo is een test die
    slaagt ook een uitspraak over wat het spel straks laadt. Kopiëren naar de output
    voorkomt dat tests het pad naar de repo-root moeten raden.
  -->
  <ItemGroup>
    <Content Include="..\..\data\maps\**\*.json"
             Link="data\maps\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <!-- colors.json en starting-armies-presets.json zijn gedeeld over kaartvarianten en
         staan in data/, niet data/maps/{mapId}/. -->
    <Content Include="..\..\data\colors.json"
             Link="data\colors.json"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\data\starting-armies-presets.json"
             Link="data\starting-armies-presets.json"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    De kaartvarianten waar de datatests over lopen, bepaald uit de bronmap en niet uit
    bin/: CopyToOutputDirectory ruimt een hernoemde of verwijderde variant nooit op, en
    die zou anders lokaal als spookkaart blijven meetesten. Eén regel per variant met
    een territories.json.
  -->
  <Target Name="WriteMapVariantList" AfterTargets="Build">
    <ItemGroup>
      <_MapVariantTerritories Include="..\..\data\maps\**\territories.json" />
    </ItemGroup>
    <WriteLinesToFile File="$(OutDir)data\map-variants.txt"
                      Lines="@(_MapVariantTerritories->'%(RecursiveDir)')"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
  </Target>

</Project>
